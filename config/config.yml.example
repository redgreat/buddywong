# buddywong 配置文件示例
# 用法：cp config/config.yml.example config/config.yml，然后按需修改。
# 所有项都可以用环境变量覆盖（见 README「配置」一节），容器部署时优先改环境变量。

# 服务配置
server:
  host: 0.0.0.0
  port: 3002
  # 数据库、日志目录（容器内固定为 /app/data、/app/logs）
  data_dir: /app/data
  log_dir: /app/logs
  # 反向代理在后时，从 X-Forwarded-For / X-Real-IP 取真实 IP
  trust_proxy: true

# 安全配置
security:
  # ⚠️ 生产环境务必改成随机强密钥！用于签发管理端会话 token。
  master_key: change_this_master_key_in_production
  admin_user: admin
  # 留空：首次启动随机生成管理员密码并打印到容器日志（docker logs buddywong）
  admin_password: ""
  session_timeout: 86400   # 会话有效期（秒）

# 反代网关配置
proxy:
  request_timeout: 120      # 单次上游请求超时（秒）
  cool_seconds: 300         # 账号连续失败后的冷却时长（秒）
  max_account_retries: 3    # 单次请求最多换几个账号重试
  # 模型别名：下游使用的名字 -> 实际转发给账号的名字
  # 例：{ "gpt-4o": "claude-sonnet-4", "bw-fast": "deepseek-v3" }
  model_alias: {}
  # 出站代理（留空直连），支持 http:// / https:// / socks5://
  http_proxy: ""

# 自动签到配置
checkin:
  enabled: true
  hour: 8                  # 每日执行时刻（容器本地时区，compose 里设 TZ=Asia/Shanghai）
  minute: 5
  log_retention_days: 30   # 调用日志/签到流水保留天数，0 = 永不清理

# WorkBuddy 真实签到协议（页面扫码登录用，端点与官方客户端一致）
# 只对 source=workbuddy 的账号生效；手工录入的账号仍走上面的通用 HTTP 签到。
workbuddy:
  cn_chat_base: https://copilot.tencent.com       # 国内版登录 / 对话 / 模型目录
  cn_billing_base: https://www.codebuddy.cn      # 国内版签到 / 积分
  global_base: https://www.workbuddy.ai          # 国际版（无签到体系，仅纳管）
  # client_version / cli_version 无需配置：默认自动从官方发布源获取并跟随升级
  #   客户端版本 <- 官网 /v2/update?platform=workbuddy-win32-x64-user
  #   CLI 版本   <- npm @tencent-ai/codebuddy-code 的 latest
  # 排查问题要临时钉死时，用环境变量 BW_WB_CLIENT_VERSION / BW_WB_CLI_VERSION，
  # 或在下面填 client_version / cli_version（填了该项就不再自动更新）。
  version_refresh_hours: 6                      # 自动同步间隔（小时）
  auto_checkin_on_login: true                   # 扫码成功后立刻签到一次
  state_ttl: 900                                # 二维码有效期（秒）
